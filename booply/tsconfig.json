{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "hooks/useSession.js",
    "nativewind-env.d.ts", 
    "app/(tabs)/groups.js", 
    "app/(tabs)/leaderboard.js"
  ]
}